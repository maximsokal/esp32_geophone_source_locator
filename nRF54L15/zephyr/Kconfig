source "Kconfig.zephyr"

menu "Application options"

config APP_LOG_TEST_EVENTS
	bool "Generate nRF log test-event bursts"
	default n
	help
	  Emit bounded LOG_TEST_EVENT bursts from the main loop for HIL ring-flood
	  and transport checks. Leave disabled in production images.

config APP_LED_BOOT_LAMP_TEST
	bool "Run the boot LED lamp test"
	default y
	help
	  Drive the external BLUE, GREEN, YELLOW, and RED LEDs briefly at boot.

config APP_NRF_STATUS_PRINT_PERIOD_MS
	int "nRF console status period in milliseconds"
	range 0 3600000
	default 5000
	help
	  Print one bounded runtime status line from the main loop. Set to zero to disable.

config APP_NRF_VERBOSE_LOG
	bool "Print nRF runtime diagnostics"
	default y
	help
	  Print upstream transaction records, state transitions, and periodic status.

config APP_NRF_STAGE_SIGNALS
	bool "Show lifecycle stage signals on the logger LEDs"
	default y
	help
	  Briefly overlay lifecycle progress and upstream-loss signals on the logger LEDs.

config APP_NRF_UPSTREAM_LOSS_TIMEOUT_MS
	int "Upstream loss signal timeout in milliseconds"
	depends on APP_NRF_STAGE_SIGNALS
	range 3000 120000
	default 15000
	help
	  ESP32 topology reconcile runs every 5 s, so the timeout must be >= 3x that;
	  the log collector polls every 1 s.

endmenu
