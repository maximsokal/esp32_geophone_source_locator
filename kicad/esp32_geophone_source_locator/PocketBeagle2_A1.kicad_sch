(text "POCKETBEAGLE 2 A1 (PB2VA1)  |  AM6254A + AD7606 + ESP32-S3" (at 15.24 15.24 0) (effects (font (size 2.54 2.54) (bold yes)) (justify left top)) (uuid 6c11f6e3-f93b-49dd-8c11-710fd581ec48))
(text "DIPLOMA / A1 TARGET / 4 simultaneous channels / up to 200 kS/s DUAL_DOUT (PRU1 200 MHz)" (at 15.24 22.86 0) (effects (font (size 1.52 1.52) ) (justify left top)) (uuid 06ec1238-90d2-4aa5-b73d-3b34b86ea51e))
(text "A1 expansion headers: 2 x 18 contacts each. Odd/even layout is logical, not a physical board view." (at 15.24 30.48 0) (effects (font (size 1.27 1.27) ) (justify left top)) (uuid e77ac74a-67ba-4539-bdf9-9bbc6c206155))
(text "P1: not used on this sheet. X marks = not connected in this design, NOT native NC pins." (at 15.24 35.56 0) (effects (font (size 1.27 1.27) ) (justify left top)) (uuid 1fd22af0-bdba-410e-930b-110639db9fa5))
(text "PB2 A1 (PB2VA1) / AM6254A (4x A53, 512MB LPDDR4, PRU0/PRU1, M4F)" (at 114.3 43.18 0) (effects (font (size 1.78 1.78) (bold yes)) (justify left top)) (uuid dd762720-431d-426a-a9d5-1c37f4fce498))
(text "P2 mux: R30 = outputs; R31 = inputs. P2.20 aliases R31.4; leave unconnected." (at 15.24 105.41 0) (effects (font (size 1.27 1.27) ) (justify left top)) (uuid ebd3bfd5-45c6-4f8a-9507-84d2a6af0247))
(text "P2.28 FRSTDATA optional; DB8/DOUTB required for proposed dual-DOUT mode." (at 15.24 110.49 0) (effects (font (size 1.27 1.27) ) (justify left top)) (uuid 713a5b96-7115-41dc-8786-f819c0d9ea5b))
(text "All P2 logic used here is 3.3 V. Verify actual overlay and header orientation before wiring." (at 15.24 115.57 0) (effects (font (size 1.27 1.27) ) (justify left top)) (uuid 688d37f7-72b3-46cd-bef3-82c0b1bcca70))
(text "UART2 / 3.3 V TTL, separate power domains" (at 236.22 116.84 0) (effects (font (size 1.52 1.52) (bold yes)) (justify left top)) (uuid 97498d23-5ed9-4038-911c-518e24e50967))
(text "ESP RX: GPIO38 on DevKitC v1.0 OR GPIO48 on v1.1; confirm board first. GPIO7 TX candidate." (at 236.22 155.58 0) (effects (font (size 1.16 1.16) ) (justify left top)) (uuid 90ff7c2f-39f0-4c30-9701-f56a466b795e))
(text "Do not connect until power-off isolation / startup sequencing is verified." (at 236.22 160.66 0) (effects (font (size 1.16 1.16) ) (justify left top)) (uuid f112405c-f49c-46e1-8b8a-651fa111c82b))
(text "R1 represents already installed CS pull-up. Do not duplicate it." (at 236.22 186.69 0) (effects (font (size 1.16 1.16) ) (justify left top)) (uuid 9b6e8430-2bed-47a8-9fcd-f76460e23cf2))
(text "ADC module: terminal IDs are signal names, not physical connector pin numbers." (at 250.19 106.68 0) (effects (font (size 1.05 1.05) ) (justify left top)) (uuid 4556d1bf-fc02-4a22-ab29-3916ad1ec1b3))
(text "V3/V4/V7/V8: not measured; terminate unused analog inputs per module/datasheet." (at 250.19 111.76 0) (effects (font (size 1.05 1.05) ) (justify left top)) (uuid 89ecc830-8516-4ff2-a60c-1dbcca54f1c5))
(text "EXCLUSIVE ADC OWNERSHIP / POWER-OFF HARNESS" (at 15.24 129.54 0) (effects (font (size 1.78 1.78) (bold yes)) (justify left top)) (uuid e380f41f-9a90-4047-99f0-47a01c21099b))
(text "Proposed BEAGLE_OWNER: remove existing ESP32 ADC wires before fitting PB2 harness." (at 15.24 137.16 0) (effects (font (size 1.27 1.27) ) (justify left top)) (uuid a27d80d1-cf8a-416a-b0f2-beeae674264b))
(text "Existing ESP32_OWNER wiring (not connected in the proposed circuit above):" (at 15.24 143.51 0) (effects (font (size 1.27 1.27) ) (justify left top)) (uuid 0b5ca683-147e-4a49-ba64-13ca143f6e07))
(text "GPIO42 -> CVA + CVB (tied)" (at 20.32 149.86 0) (effects (font (size 1.27 1.27) ) (justify left top)) (uuid ef77a0fe-36ff-4f40-aab2-f8158270faf0))
(text "GPIO2 -> RESET; GPIO41 -> CS#" (at 20.32 154.94 0) (effects (font (size 1.27 1.27) ) (justify left top)) (uuid 801b4bd8-624d-4004-b86a-3712d44c926d))
(text "GPIO40 -> RD/SCLK; GPIO47 <- BUSY" (at 20.32 160.02 0) (effects (font (size 1.27 1.27) ) (justify left top)) (uuid 858c6db7-6cbe-45fc-88a0-19b5cb2db6be))
(text "GPIO39 <- DOUTA/DB7; common GND" (at 20.32 165.1 0) (effects (font (size 1.27 1.27) ) (justify left top)) (uuid b2a11dd8-6c84-4ba3-8b06-89ff187e624d))
(text "Original analog mapping: G1..G4 -> V1..V4" (at 20.32 170.18 0) (effects (font (size 1.27 1.27) ) (justify left top)) (uuid f9729c17-cd8a-4ed6-88d4-3c016f602612))
(text "BEAGLE_OWNER dual-DOUT candidate: G1/G2 -> V1/V2; G3/G4 -> V5/V6." (at 15.24 178 0) (effects (font (size 1.27 1.27) ) (justify left top)) (uuid 885fc00c-c91f-44fa-a479-383bb747fabb))
(text "32 SCLK edges intended per output lane; verify truncated read, timing and VDRIVE." (at 15.24 183.08 0) (effects (font (size 1.27 1.27) ) (justify left top)) (uuid 7cdac956-1643-4dfb-80c1-92ffb17ad01c))
(text "No 200 kS/s guarantee at 3.3 V; prove with datasheet, logic analyzer and HIL." (at 15.24 188.16 0) (effects (font (size 1.27 1.27) ) (justify left top)) (uuid 52d9ffef-df73-4c3f-ba3f-d2609183b402))
(text "POWER / SAFETY (no direct power-rail interconnect)" (at 15.24 201.93 0) (effects (font (size 1.78 1.78) (bold yes)) (justify left top)) (uuid 123e33e1-3759-4a90-8029-a77692919db9))
(text "PB2: separate USB-C 5 V supply during bring-up. P1 VIN not connected here." (at 15.24 209.55 0) (effects (font (size 1.27 1.27) ) (justify left top)) (uuid 52676ce8-9bde-41a5-8e93-f4118146282c))
