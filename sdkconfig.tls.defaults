# GeoLocator TLS runtime memory policy.
#
# ESP32-S3 N16R8 has 8 MB PSRAM. HTTPS handshakes were exhausting the
# fragmented internal DRAM after Wi-Fi/LVGL/server startup with
# MBEDTLS_ERR_SSL_ALLOC_FAILED (-0x7F00). Keep scarce internal RAM for
# Wi-Fi, LVGL and DMA-capable drivers; allocate mbedTLS dynamic state in
# external SPIRAM instead.
#
# IMPORTANT: sdkconfig has higher priority than these defaults. If a local
# sdkconfig predates this policy, delete/regenerate it. app_build_config_guard.c
# intentionally fails the build when the effective configuration is stale.
#
# Component config -> mbedTLS -> Memory allocation strategy -> External SPIRAM
#
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# ESP32-S3 hardware AES uses DMA. When mbedTLS buffers live in PSRAM the AES
# port may need temporary MALLOC_CAP_DMA buffers in internal RAM (up to a
# 1600-byte processing chunk per buffer). With the display, Wi-Fi, HTTPD and
# concurrent browser TLS sessions this fragmented the remaining internal heap
# enough to make HTTPS writes fail with "esp-aes: Failed to allocate memory".
# The local dashboard workload is small, so prefer software AES and preserve
# internal DMA memory for the rest of the device.
#
# CONFIG_MBEDTLS_HARDWARE_AES is not set
# CONFIG_MBEDTLS_AES_USE_INTERRUPT is not set

# Browser HTTPS needs enough internal RAM for simultaneous sockets while
# Wi-Fi, LVGL, SDSPI and acquisition stay active. Reserve a larger pool that
# ordinary malloc() cannot consume but MALLOC_CAP_INTERNAL / MALLOC_CAP_DMA
# users can. SDSPI needs this pool for its 512-byte DMA bounce buffer when a
# FatFs destination is not directly DMA-capable.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# The generated base sdkconfig historically preferred internal RAM for normal
# malloc() calls up to 16 KiB. That puts object-store 4 KiB JSON scratch buffers
# in the same scarce internal heap needed by Wi-Fi/HTTPD/DMA. Prefer PSRAM for
# ordinary allocations larger than 2 KiB instead; explicit DMA/internal-cap
# allocations are unaffected by this threshold.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048

# ESP-IDF can place zero-initialized data from lwIP, net80211, libpp and
# wpa_supplicant in PSRAM, freeing internal static DRAM without moving the
# HTTPD task stack out of internal memory.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
