/*
 * Project-level corrections for the plain Seeed Studio XIAO nRF54L15.
 *
 * The pinned Seeed board definition currently describes a Sense-style
 * LSM6DS3TR-C on i2c30 and exposes it as imu0. The diploma hardware uses the
 * plain XIAO and an external GY-BMI160 on the private D11/D12 bus instead.
 * Keep i2c30 itself enabled; only disable the nonexistent onboard IMU node.
 *
 * The same board definition maps D4/D5 to i2c22 as TWIM by default. This
 * project uses that peripheral as the upstream I2C target, so only i2c22 is
 * switched to TWIS. The private i2c30 sensor bus remains TWIM/controller.
 */

/ {
    aliases {
        /delete-property/ imu0;
    };
};

&lsm6ds3tr_c {
    status = "disabled";
};

&i2c22_default {
    group1 {
        psels = <NRF_PSEL(TWIS_SDA, 1, 10)>,
                <NRF_PSEL(TWIS_SCL, 1, 11)>;
        bias-pull-up;
    };
};

&i2c22_sleep {
    group1 {
        psels = <NRF_PSEL(TWIS_SDA, 1, 10)>,
                <NRF_PSEL(TWIS_SCL, 1, 11)>;
    };
};

&i2c22 {
    compatible = "nordic,nrf-twis";
    pinctrl-0 = <&i2c22_default>;
    pinctrl-1 = <&i2c22_sleep>;
    pinctrl-names = "default", "sleep";
    status = "okay";
};
