{
  "schema_version": 1,
  "primary": true,
  "board": {
    "name": "PocketBeagle 2",
    "marking": "PB2VA1",
    "revision": "A1",
    "soc": "TI AM6254A",
    "cores": "4x ARM Cortex-A53",
    "ram_mb": 512,
    "ram_type": "LPDDR4",
    "gpu": "AXE-1-16",
    "pru_subsystem": "PRU-SS (PRU0, PRU1)",
    "mcu_cores": ["Cortex-M4F", "MSPM0L1105"],
    "arch": "aarch64"
  },
  "linux_image": {
    "distro": "Debian 13.3 Minimal TI 6.12.x",
