# GeoLocator TLS runtime memory policy.
#
# ESP32-S3 N16R8 has 8 MB PSRAM, but target logs showed that forcing *all*
# mbedTLS allocations into PSRAM is not stable for the browser workload. After
# several HTTPS handshakes the PSRAM TLSF heap asserted in block_locate_free()
# while mbedTLS was parsing the RSA private key for a new server session.
#
# Keep the 2 KiB malloc threshold and use ESP-IDF's normal allocator instead:
# small crypto/key/session allocations prefer internal DRAM, while large TLS
# RX/TX buffers prefer PSRAM. This is exactly the split we want on N16R8 and
# avoids sending every short-lived MPI allocation through the PSRAM heap.
#
# IMPORTANT: sdkconfig has higher priority than these defaults. If a local
# sdkconfig predates this policy, delete/regenerate it. app_build_config_guard.c
# intentionally fails the build when the effective configuration is stale.
#
# Component config -> mbedTLS -> Memory allocation strategy -> Default allocator
#
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
# CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC is not set
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y

# Dynamic TX/RX buffers save memory on smaller targets, but this board has 8 MB
# PSRAM and the observed failure followed repeated TLS allocation/free churn.
# Keep one RX/TX pair for the lifetime of each TLS session instead of repeatedly
# allocating and freeing those buffers. With one HTTPS client at a time this is
# a small, bounded PSRAM cost compared with the available external heap.
# CONFIG_MBEDTLS_DYNAMIC_BUFFER is not set

# ESP32-S3 hardware AES uses DMA. Large TLS buffers now normally live in PSRAM,
# so hardware AES can still require temporary MALLOC_CAP_DMA bounce buffers in
# scarce internal RAM. Keep software AES until a target benchmark proves the
# hardware path is both faster and memory-safe under concurrent recording.
# CONFIG_MBEDTLS_HARDWARE_AES is not set
# CONFIG_MBEDTLS_AES_USE_INTERRUPT is not set

# Browser HTTPS needs enough internal RAM for simultaneous sockets while
# Wi-Fi, LVGL, SDSPI and acquisition stay active. Reserve a pool that ordinary
# malloc() cannot consume but MALLOC_CAP_INTERNAL / MALLOC_CAP_DMA users can.
# SDSPI needs this pool for its 512-byte DMA bounce buffer when a FatFs
# destination is not directly DMA-capable.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# Standard malloc/calloc uses this threshold when PSRAM is enabled:
# <= 2 KiB prefers internal RAM, > 2 KiB prefers PSRAM, with fallback to the
# other heap if the preferred one cannot satisfy the request. This keeps RSA
# MPI/key bookkeeping internal while 4 KiB/16 KiB TLS buffers prefer PSRAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048

# ESP-IDF can place zero-initialized data from lwIP, net80211, libpp and
# wpa_supplicant in PSRAM, freeing internal static DRAM without moving the
# HTTPD task stack out of internal memory.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# GeoLocator is a local browser dashboard. Chrome commonly opens fresh TLS
# sockets while loading/navigating the app. RFC5077 server session tickets let
# the browser resume a previously authenticated TLS 1.2 session instead of
# repeating the full RSA certificate handshake on every new socket.
CONFIG_MBEDTLS_SERVER_SSL_SESSION_TICKETS=y
CONFIG_ESP_TLS_SERVER_SESSION_TICKETS=y
CONFIG_ESP_TLS_SERVER_SESSION_TICKET_TIMEOUT=3600

# We do not use post-handshake client authentication or key-refresh
# renegotiation. Disabling legacy TLS 1.2 renegotiation removes an unnecessary
# handshake path on this constrained local server.
# CONFIG_MBEDTLS_SSL_RENEGOTIATION is not set
