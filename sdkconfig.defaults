# ESP32-S3 N16R8 hardware configuration

# 16 MB SPI Flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# 8 MB Octal PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y

# Conservative PSRAM clock confirmed working on this board
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_SPEED=40

# Initialize PSRAM during boot
CONFIG_SPIRAM_BOOT_HW_INIT=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_PRE_CONFIGURE_MEMORY_PROTECTION=y

# Make PSRAM available through malloc()
CONFIG_SPIRAM_USE_MALLOC=y

# Test PSRAM during startup
CONFIG_SPIRAM_MEMTEST=y

# Keep small allocations and DMA-critical memory internal
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768