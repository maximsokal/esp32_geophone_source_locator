{
  "name": "geolocator-webui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/prepare-esp-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test:xr": "npx --yes vitest@4.1.11 run tests/xr",
    "test:xr:coverage": "npx --yes --package=vitest@4.1.11 --package=@vitest/coverage-v8@4.1.11 vitest run tests/xr --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=json-summary --coverage.include=src/xr/surfelEvidence.ts --coverage.include=src/xr/depthPointCloudV2.ts --coverage.include=src/xr/depthPointCloud.ts --coverage.include=src/xr/occupancyEvidence.ts --coverage.include=src/xr/webxrFusionQuality.ts --coverage.include=src/xr/meshPreview.ts",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@react-three/fiber": "9.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
