# Storage filesystem requirements.
#
# The application uses path components longer than FAT 8.3 names
# (for example /sdcard/geolocator), so long filename support is a
# functional requirement rather than an optional convenience.
# CONFIG_FATFS_LFN_NONE is not set
CONFIG_FATFS_LFN_HEAP=y
# CONFIG_FATFS_LFN_STACK is not set
CONFIG_FATFS_MAX_LFN=255

# Keep the FatFs work area and sector window in internal RAM. The SD card is
# attached through SDSPI, and placing the FatFs work area in PSRAM makes the
# SD/MMC layer allocate a temporary MALLOC_CAP_DMA bounce buffer for sector
# reads. Under concurrent HTTPS/TLS clients that internal DMA allocation can
# fail with ESP_ERR_NO_MEM even though plenty of PSRAM remains.
# CONFIG_FATFS_ALLOC_PREFER_EXTRAM is not set
