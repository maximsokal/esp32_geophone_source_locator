    "default_host": "192.168.7.2",
    "default_user": "debian",
    "remote_dir": "/home/debian/pb2_locator"
  },
  "uart2": {
    "pb2_tx": { "header": "P2.04", "pad_offset": "0x00BC", "mux_mode": 4 },
