{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:esp32-geophone:performance-record:2",
  "title": "ESP32 geophone performance acceptance record v2",
  "description": "One record per reproducible workload scenario. not_applicable is explicit and is never inferred by the validator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "firmware_sha256", "build_profile", "optimization_mode", "test_surface",
    "sample_rate_hz", "channel_count", "sample_format", "channel_sentinel_order", "sd_card_identity", "sd_card_frequency_hz",
    "workload_id", "seed", "duration_ms", "classification",
    "produced_frames", "ingested_frames", "persisted_frames", "explicitly_dropped_frames",
    "explicitly_rejected_frames", "resident_frames", "acquisition_service_jitter_us",
    "recorder_write_latency_us", "bytes_per_write", "writes_per_second",
    "ring_high_water_frames", "cache_high_water_frames", "queue_high_water",
    "cpu_runtime_us", "task_runtime_us", "core_runtime_us",
    "internal_heap_free_bytes", "internal_heap_largest_block_bytes", "psram_free_bytes",
    "psram_largest_block_bytes", "stack_hwm_bytes", "web_stop_latency_ms",
    "web_status_latency_ms", "live_latency_ms", "reset_markers",
    "project_hot_path_allocation_violations", "active_allocation_count",
    "diagnostic_reports_suppressed", "diagnostic_reports_coalesced", "v2_quantizer_calls",
    "raw_path_selection", "seismic_buffer_atomic_operations",
    "seismic_buffer_critical_section_entries", "seismic_buffer_retries",
    "ad7606_status_critical_section_entries", "ad7606_status_critical_section_total_us",
    "ad7606_status_critical_section_max_us", "frame_duplication_detected",
    "frame_reordering_detected", "channel_swap_detected", "corrupted_finalized_file",
    "corrupted_finalized_session",
    "dirty_cache_overwrite_detected", "diagnostic_integer_overflow_detected",
    "deadlock_detected", "workload_supported", "unsupported_workload_disposition"
  ],
  "$defs": {
    "notApplicable": { "const": "not_applicable" },
    "count": { "type": "integer", "minimum": 0 },
    "positiveCount": { "type": "integer", "minimum": 1 },
    "number": { "type": "number", "minimum": 0 },
    "countOrNA": { "oneOf": [{ "$ref": "#/$defs/count" }, { "$ref": "#/$defs/notApplicable" }] },
    "numberOrNA": { "oneOf": [{ "$ref": "#/$defs/number" }, { "$ref": "#/$defs/notApplicable" }] },
    "flagOrNA": { "oneOf": [{ "type": "boolean" }, { "$ref": "#/$defs/notApplicable" }] },
    "percentiles": {
      "type": "object", "additionalProperties": false,
      "required": ["p50", "p95", "p99", "max"],
      "properties": {
        "p50": { "$ref": "#/$defs/number" },
        "p95": { "$ref": "#/$defs/number" },
        "p99": { "$ref": "#/$defs/number" },
        "max": { "$ref": "#/$defs/number" }
      }
    }
  },
  "properties": {
    "schema_version": { "const": 2 },
    "firmware_sha256": { "oneOf": [{ "type": "string", "pattern": "^[0-9a-f]{64}$" }, { "$ref": "#/$defs/notApplicable" }] },
    "build_profile": { "enum": ["DEBUG", "PERFORMANCE", "not_applicable"] },
    "optimization_mode": { "enum": ["debug", "performance", "not_applicable"] },
    "test_surface": { "enum": ["HOST_VIRTUAL", "TARGET_STRESS", "LIVE_HIL"] },
    "sample_rate_hz": { "oneOf": [{ "$ref": "#/$defs/positiveCount" }, { "$ref": "#/$defs/notApplicable" }] },
    "channel_count": { "oneOf": [{ "$ref": "#/$defs/positiveCount" }, { "$ref": "#/$defs/notApplicable" }] },
    "sample_format": { "type": "string", "minLength": 1 },
    "channel_sentinel_order": {
      "oneOf": [
        { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["frame", "negative_frame", "frame_plus_quarter", "frame_minus_quarter"] } },
        { "$ref": "#/$defs/notApplicable" }
      ]
    },
    "sd_card_identity": { "type": "string", "minLength": 1, "x-physical-only": true, "x-host-virtual-must-be-na": true },
    "sd_card_frequency_hz": { "oneOf": [{ "$ref": "#/$defs/positiveCount" }, { "$ref": "#/$defs/notApplicable" }], "x-physical-only": true, "x-host-virtual-must-be-na": true },
    "workload_id": { "type": "string", "minLength": 1 },
    "seed": { "$ref": "#/$defs/count" },
    "duration_ms": { "$ref": "#/$defs/positiveCount" },
    "classification": { "enum": ["PASS", "SATURATED", "REJECTED"] },
    "produced_frames": { "$ref": "#/$defs/count" },
    "ingested_frames": { "$ref": "#/$defs/count" },
    "persisted_frames": { "$ref": "#/$defs/count" },
    "explicitly_dropped_frames": { "$ref": "#/$defs/count" },
    "explicitly_rejected_frames": { "$ref": "#/$defs/count" },
    "resident_frames": { "$ref": "#/$defs/count" },
    "acquisition_service_jitter_us": { "oneOf": [{ "$ref": "#/$defs/percentiles" }, { "$ref": "#/$defs/notApplicable" }] },
    "recorder_write_latency_us": { "oneOf": [{ "$ref": "#/$defs/percentiles" }, { "$ref": "#/$defs/notApplicable" }] },
    "bytes_per_write": { "$ref": "#/$defs/numberOrNA" },
    "writes_per_second": { "$ref": "#/$defs/numberOrNA" },
    "ring_high_water_frames": { "$ref": "#/$defs/countOrNA" },
    "cache_high_water_frames": { "$ref": "#/$defs/countOrNA" },
    "queue_high_water": { "$ref": "#/$defs/countOrNA" },
    "cpu_runtime_us": { "$ref": "#/$defs/countOrNA", "x-host-virtual-must-be-na": true },
    "task_runtime_us": { "$ref": "#/$defs/countOrNA", "x-host-virtual-must-be-na": true },
    "core_runtime_us": { "$ref": "#/$defs/countOrNA", "x-host-virtual-must-be-na": true },
    "internal_heap_free_bytes": { "$ref": "#/$defs/countOrNA", "x-host-virtual-must-be-na": true },
    "internal_heap_largest_block_bytes": { "$ref": "#/$defs/countOrNA", "x-host-virtual-must-be-na": true },
    "psram_free_bytes": { "$ref": "#/$defs/countOrNA", "x-host-virtual-must-be-na": true },
    "psram_largest_block_bytes": { "$ref": "#/$defs/countOrNA", "x-host-virtual-must-be-na": true },
    "stack_hwm_bytes": { "$ref": "#/$defs/countOrNA", "x-host-virtual-must-be-na": true },
    "web_stop_latency_ms": { "$ref": "#/$defs/numberOrNA", "x-host-virtual-must-be-na": true },
    "web_status_latency_ms": { "$ref": "#/$defs/numberOrNA", "x-host-virtual-must-be-na": true },
    "live_latency_ms": { "$ref": "#/$defs/numberOrNA", "x-host-virtual-must-be-na": true },
    "reset_markers": {
      "type": "object", "additionalProperties": false,
      "required": ["unexpected_reset", "watchdog", "brownout"],
      "properties": {
        "unexpected_reset": { "$ref": "#/$defs/flagOrNA" },
        "watchdog": { "$ref": "#/$defs/flagOrNA" },
        "brownout": { "$ref": "#/$defs/flagOrNA" }
      }
    },
    "project_hot_path_allocation_violations": { "$ref": "#/$defs/countOrNA", "x-host-virtual-must-be-na": true },
    "active_allocation_count": { "$ref": "#/$defs/countOrNA", "x-host-virtual-must-be-na": true },
    "diagnostic_reports_suppressed": { "$ref": "#/$defs/countOrNA", "x-host-virtual-must-be-na": true },
    "diagnostic_reports_coalesced": { "$ref": "#/$defs/countOrNA", "x-host-virtual-must-be-na": true },
    "v2_quantizer_calls": { "$ref": "#/$defs/countOrNA", "x-host-virtual-must-be-na": true },
    "raw_path_selection": { "enum": ["RAW", "QUANTIZED", "not_applicable"], "x-host-virtual-must-be-na": true },
    "seismic_buffer_atomic_operations": { "$ref": "#/$defs/countOrNA", "x-host-virtual-must-be-na": true },
    "seismic_buffer_critical_section_entries": { "$ref": "#/$defs/countOrNA", "x-host-virtual-must-be-na": true },
    "seismic_buffer_retries": { "$ref": "#/$defs/countOrNA", "x-host-virtual-must-be-na": true },
    "ad7606_status_critical_section_entries": { "$ref": "#/$defs/countOrNA", "x-host-virtual-must-be-na": true },
    "ad7606_status_critical_section_total_us": { "$ref": "#/$defs/countOrNA", "x-host-virtual-must-be-na": true },
    "ad7606_status_critical_section_max_us": { "$ref": "#/$defs/countOrNA", "x-host-virtual-must-be-na": true },
    "frame_duplication_detected": { "$ref": "#/$defs/flagOrNA" },
    "frame_reordering_detected": { "$ref": "#/$defs/flagOrNA" },
    "channel_swap_detected": { "$ref": "#/$defs/flagOrNA" },
    "corrupted_finalized_file": { "$ref": "#/$defs/flagOrNA" },
    "corrupted_finalized_session": { "$ref": "#/$defs/flagOrNA" },
    "dirty_cache_overwrite_detected": { "$ref": "#/$defs/flagOrNA" },
    "diagnostic_integer_overflow_detected": { "$ref": "#/$defs/flagOrNA" },
    "deadlock_detected": { "$ref": "#/$defs/flagOrNA" },
    "workload_supported": { "oneOf": [{ "type": "boolean" }, { "$ref": "#/$defs/notApplicable" }] },
    "unsupported_workload_disposition": { "enum": ["not_applicable", "REJECTED", "SATURATED"] }
  }
}
